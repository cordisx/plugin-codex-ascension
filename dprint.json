{
  "includes": [
    "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}"
  ],
  "excludes": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/package-lock.json",
    ".next/**",
    ".vinext/**",
    "out/**",
    ".wrangler/**",
    "outputs/**",
    "work/**",
    "next-env.d.ts",
    "plugin/src/assets/identity/generated.ts",
    "plugin/src/assets/portraits/generated.ts",
    "drizzle/meta/*.json"
  ],
  "extends": "https://raw.githubusercontent.com/cordisx/cordisxmono/c63c2e8c2ba7e11502934a52ad2ce3734e804cdc/tooling/quality/dprint/code.json",
  "typescript": {
    "jsx.quoteStyle": "preferDouble",
    "semiColons": "always"
  }
}
